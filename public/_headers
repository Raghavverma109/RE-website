# Cache headers. This file is read by Netlify and Cloudflare Pages; on other
# hosts it is an inert text file and you want the equivalent config instead —
# see "CDN" in docs/media-workflow.md for Vercel / nginx / Workers.
#
# VERIFY AFTER FIRST DEPLOY:
#   curl -sI https://<your-url>/assets/video/hero-v1.mp4 | grep -i cache-control
# If the header is missing, your host ignores this file.

# Fingerprinted build output — Vite puts a content hash in every filename, so
# the URL changes whenever the bytes change. Safe to cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/_build/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Raw media in public/. Not auto-fingerprinted — safe to cache forever because
# every filename carries its own version (hero-v1.mp4). New footage ships as
# hero-v2.* at a new URL. See the header comment in src/lib/media.ts.
/assets/video/*
  Cache-Control: public, max-age=31536000, immutable

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# HTML must revalidate, or deploys never reach returning visitors. This is the
# rule that makes everything above safe: the HTML is always fresh, so it always
# points at the current asset filenames.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate
